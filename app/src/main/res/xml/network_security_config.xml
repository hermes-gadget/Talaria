<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
        Release posture: system CAs only. Cleartext HTTP stays permitted in
        the base config because Talaria connects to user-configured
        self-hosted Hermes hosts (arbitrary LAN IPs such as 192.168.x entered
        in the Connect screen) which are frequently plain HTTP. The actual
        cleartext gate is the app-level CleartextPolicyInterceptor
        (CleartextPolicy): it only allows verified private/local destinations
        and requires a persisted per-profile decision (allowCleartext), so a
        static XML ban would reject legitimate LAN hosts before app policy
        could evaluate them.

        User-installed CA certificates are trusted ONLY in debug builds, so a
        release APK cannot be MITM'd by a certificate planted on the device.
        For HTTPS hosts, per-profile TLS pinning (CertificatePinnerFactory)
        provides the hostile-network defense.
    -->
    <!-- InsecureBaseConfiguration: intentional — see the policy comment above. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
