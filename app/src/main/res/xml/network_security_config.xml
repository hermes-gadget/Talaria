<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Release posture: system CAs only and no arbitrary cleartext. The
        explicit local exceptions support the emulator/loopback development
        targets; ConnectionRepository and CleartextPolicyInterceptor still
        require a persisted per-profile decision and reject non-local hosts.
        TLS pinning is never treated as protection for HTTP.

        User-installed CA certificates are trusted ONLY in debug builds, so a
        release APK cannot be MITM'd by a certificate planted on the device.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
